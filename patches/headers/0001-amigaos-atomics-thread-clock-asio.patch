diff -ru a/boost/atomic/detail/caps_gcc_atomic.hpp b/boost/atomic/detail/caps_gcc_atomic.hpp
--- a/boost/atomic/detail/caps_gcc_atomic.hpp	2026-11-06 08:02:39.724805459 +0000
+++ b/boost/atomic/detail/caps_gcc_atomic.hpp	2026-11-06 08:02:39.743350446 +0000
@@ -99,6 +99,21 @@
 #define BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT64_LOCK_FREE 0
 #endif
 
+// AmigaOS on m68k: GCC says 1 ("sometimes lock free") for 8-, 16- and 32-bit
+// atomics and calls libatomic, which guards each operation, because the
+// Amiga's chip bus cannot do CAS/TAS cycles. Those calls are atomic between
+// tasks, so use them (link -latomic); 64-bit values use the lock pool.
+#if defined(__amigaos__)
+#undef BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT8_LOCK_FREE
+#define BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT8_LOCK_FREE 2
+#undef BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT16_LOCK_FREE
+#define BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT16_LOCK_FREE 2
+#undef BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT32_LOCK_FREE
+#define BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT32_LOCK_FREE 2
+#undef BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT64_LOCK_FREE
+#define BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT64_LOCK_FREE 0
+#endif
+
 // Override arch-specific macros if atomic intrinsics provide better guarantees
 #if !defined(BOOST_ATOMIC_INT128_LOCK_FREE) || (BOOST_ATOMIC_INT128_LOCK_FREE < BOOST_ATOMIC_DETAIL_GCC_ATOMIC_INT128_LOCK_FREE)
 #undef BOOST_ATOMIC_INT128_LOCK_FREE
