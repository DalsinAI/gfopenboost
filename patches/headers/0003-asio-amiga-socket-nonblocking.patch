diff -ru a/boost/asio/detail/impl/reactive_socket_service_base.ipp b/boost/asio/detail/impl/reactive_socket_service_base.ipp
--- a/boost/asio/detail/impl/reactive_socket_service_base.ipp	2026-11-07 15:54:37.277733691 +0000
+++ b/boost/asio/detail/impl/reactive_socket_service_base.ipp	2026-11-07 15:54:37.295914590 +0000
@@ -229,7 +229,12 @@
   case SOCK_DGRAM: impl.state_ = socket_ops::datagram_oriented; break;
   default: impl.state_ = 0; break;
   }
+#if !defined(__amigaos__)
+  // (AmigaOS: no dup() of sockets, and libnix's fcntl() can't make a
+  // socket non-blocking, which is what possible_dup would choose; so an
+  // assigned or accepted socket keeps the FIONBIO path.)
   impl.state_ |= socket_ops::possible_dup;
+#endif
   ec = boost::system::error_code();
   return ec;
 }
diff -ru a/boost/asio/detail/impl/socket_ops.ipp b/boost/asio/detail/impl/socket_ops.ipp
--- a/boost/asio/detail/impl/socket_ops.ipp	2026-11-07 15:46:44.427694484 +0000
+++ b/boost/asio/detail/impl/socket_ops.ipp	2026-11-07 15:54:37.267642441 +0000
@@ -90,6 +90,12 @@
 #if defined(BOOST_ASIO_WINDOWS) || defined(__CYGWIN__)
     ec = boost::system::error_code(WSAGetLastError(),
         boost::asio::error::get_system_category());
+#elif defined(__amigaos__)
+    // The Amiga stack (through libnix) reports EINPROGRESS where a
+    // non-blocking recv/send/accept would block; Asio then waits for the
+    // socket as for EWOULDBLOCK. connect() takes either.
+    ec = boost::system::error_code(errno == EINPROGRESS ? EWOULDBLOCK : errno,
+        boost::asio::error::get_system_category());
 #else
     ec = boost::system::error_code(errno,
         boost::asio::error::get_system_category());
