diff -ru a/boost/asio/detail/impl/socket_ops.ipp b/boost/asio/detail/impl/socket_ops.ipp
--- a/boost/asio/detail/impl/socket_ops.ipp	2026-11-07 15:46:44.427694484 +0000
+++ b/boost/asio/detail/impl/socket_ops.ipp	2026-11-07 15:46:44.441881212 +0000
@@ -90,6 +90,12 @@
 #if defined(BOOST_ASIO_WINDOWS) || defined(__CYGWIN__)
     ec = boost::system::error_code(WSAGetLastError(),
         boost::asio::error::get_system_category());
+#elif defined(__amigaos__)
+    // The Amiga stack (through libnix) reports EINPROGRESS where a
+    // non-blocking recv/send/accept would block; Asio then waits for the
+    // socket as for EWOULDBLOCK. connect() takes either.
+    ec = boost::system::error_code(errno == EINPROGRESS ? EWOULDBLOCK : errno,
+        boost::asio::error::get_system_category());
 #else
     ec = boost::system::error_code(errno,
         boost::asio::error::get_system_category());
